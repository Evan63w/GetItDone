{
    "app": "npx ts-node --prefer-ts-exts bin/get-it-done.ts",
    "watch": {
        "include": [
            "**/*.ts"
        ],
        "exclude": [
            "README.md",
            "cdk*.json",
            "**/*.d.ts",
            "**/*.js"
        ]
    },
    "context": {
        "@aws-cdk/core:enablePartitionLiterals": true
    }
}